#!/bin/bash
# wp — control the wallpaper curator.
#   wp / wp skip    next wallpaper
#   wp love         it moved you (strongest signal)
#   wp interesting  it engaged you without moving you
#   wp meh          it left you cold (image stays)
#   wp ban          never again, skip ahead
#   wp info / open  what is this, and open its source page
#   wp fetch        intake + curation now
#   wp curate       curation over the current queue
#   wp seed         (re)establish the macOS grant for the stable wallpaper file
#   wp auth         store a year-long curator token, so curation never needs a login
#   wp status       curator health, pool, queue, bandit, next up
# Every reaction is logged with the image it targets and its on-screen dwell.
# Day-to-day commands end with a warning line while curation is failing.
set -euo pipefail
BASE="$HOME/.wallpaper-rotator"
TOKEN_SERVICE="awe-some-wallpapers.claude-token"   # shared with curate.sh and health.py
cmd="${1:-next}"

log_action() {
  local image dwell
  image=$(basename "$(cat "$BASE/current.txt" 2>/dev/null)" 2>/dev/null || true)
  # /usr/bin/stat explicitly: a GNU stat on PATH treats -f as "filesystem"
  dwell=$(( $(date +%s) - $(/usr/bin/stat -f %m "$BASE/current.txt" 2>/dev/null || date +%s) ))
  /usr/bin/python3 -I "$BASE/events.py" append reaction "cmd=$cmd" "image=$image" "dwell_s=$dwell" >/dev/null
}

# A health check must never break the command it rides on; its own errors still print.
warn_health() { /usr/bin/python3 -I "$BASE/health.py" || true; }

# read_pasted_token — read a paste from stdin without echo, until an empty line
# or EOF, every line joined with whitespace dropped. Prints what was pasted.
read_pasted_token() {
  local token="" line
  while IFS= read -rs line || [[ -n "$line" ]]; do
    line=${line//[[:space:]]/}
    [[ -z "$line" && -n "$token" ]] && break
    token+=$line
  done
  printf '%s' "$token"
}

# recording MODE FILE — read a terminal recording of `claude setup-token`, or a paste.
#   token  the setup-token token: escapes stripped, wrapped lines rejoined, a
#          repeated paste collapsed, the last occurrence kept; nothing if absent
#   tail   the last lines as plain text, to show why a sign-in produced no token
recording() {
  /usr/bin/python3 -I - "$@" <<'EOF'
import re, sys
mode, path = sys.argv[1], sys.argv[2]
text = open(path, "rb").read().decode("utf-8", "replace")
text = re.sub(r"\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)", "", text)        # OSC sequences
text = re.sub(r"\x1b\[[0-9;?<=>]*[ -/]*[@-~]|\x1b[@-_]", "", text)  # CSI and 2-byte escapes
if mode == "tail":
    lines = [l.strip() for l in text.replace("\r", "\n").split("\n") if l.strip()]
    print("\n".join(lines[-8:]))
    sys.exit()
PREFIX = "sk-ant-oat01-"
starts = [m.start() for m in re.finditer(re.escape(PREFIX), text)]
tokens = []
for i, s in enumerate(starts):
    window = text[s + len(PREFIX): starts[i + 1] if i + 1 < len(starts) else len(text)]
    cut = window.find("Store this token")      # the line setup-token prints next
    window = window[:cut] if cut != -1 else window[:600]
    body = re.match(r"[A-Za-z0-9_-]*", re.sub(r"\s+", "", window)).group(0)
    if len(body) >= 20:
        tokens.append(PREFIX + body)
print(tokens[-1] if tokens else "", end="")
EOF
}

# probe_token TOKEN MODEL — one tiny request with TOKEN, in the same minimal
# environment curate.sh gives the curator. Prints the CLI's output.
probe_token() {
  env -i HOME="$HOME" USER="$(id -un)" LOGNAME="$(id -un)" SHELL="${SHELL:-/bin/zsh}" \
    PATH="/usr/bin:/bin:/usr/sbin:/sbin:$HOME/.local/bin" TMPDIR="${TMPDIR:-/tmp/}" \
    CLAUDE_CODE_OAUTH_TOKEN="$1" "$CLAUDE" -p "Reply with the single word ok." \
    --model "$2" --effort low 2>&1
}

case "$cmd" in
  next|skip|n)   log_action; bash "$BASE/rotate.sh"; warn_health ;;
  love)          log_action; echo "noted: loved"; "$BASE/info.sh"; warn_health ;;
  interesting|inter) log_action; echo "noted: interesting"; warn_health ;;
  meh)           log_action; echo "noted: meh"; warn_health ;;
  ban)
    log_action
    current=$(cat "$BASE/current.txt"); name=$(basename "$current")
    rm -f "$current" "$HOME/Pictures/WorldWallpapers/.display/$name"
    echo "banned $name"; bash "$BASE/rotate.sh"; warn_health ;;
  info)          "$BASE/info.sh"; warn_health ;;
  open)          log_action; "$BASE/info.sh" open ;;
  fetch)         /usr/bin/python3 -I "$BASE/fetch.py" ;;
  curate)        bash "$BASE/curate.sh" ;;
  seed)          bash "$BASE/seed.sh" ;;
  auth)  # once a year: a long-lived token for headless curation, kept in the login keychain
    CLAUDE=$(command -v claude || echo "$HOME/.local/bin/claude")
    model=$(/usr/bin/python3 -I -c "import json;print(json.load(open('$BASE/config.json')).get('curator_model','claude-opus-5-5'))")
    rec=$(/usr/bin/mktemp -t wp-auth)   # mode 0600; holds the token only until it is read
    trap '/bin/rm -f "$rec"' EXIT
    echo "Sign in with the account curation should use: your browser opens, approve it there."
    # Recorded, so the token is captured without copying; on the terminal's
    # alternate screen, so it is gone from view and scrollback afterwards.
    printf '\033[?1049h'
    /usr/bin/script -q "$rec" "$CLAUDE" setup-token || true   # judged by whether a token came out
    printf '\033[?1049l'
    token=$(recording token "$rec")
    if [[ -z "$token" ]]; then
      echo "The sign-in produced no token. Its last lines:"
      recording tail "$rec" | /usr/bin/sed 's/^/  /'
      : > "$rec"
      echo "If a token was shown, paste it here, then press Enter on an empty line. Typing is hidden."
      read_pasted_token > "$rec"; echo
      token=$(recording token "$rec")
    fi
    : > "$rec"
    if [[ -z "$token" ]]; then
      echo "No token found, so nothing was stored."
      exit 1
    fi
    echo "Got a ${#token}-character token ending in ...${token: -4}. Checking it against $model..."
    if ! out=$(probe_token "$token" "$model"); then
      echo "Token check failed, so nothing was stored: $out"
      exit 1
    fi
    # Through stdin rather than argv, so the token never shows in the process list.
    printf 'add-generic-password -U -a %s -s %s -w %s\n' "$(id -un)" "$TOKEN_SERVICE" "$token" | /usr/bin/security -i
    if [[ "$(/usr/bin/security find-generic-password -s "$TOKEN_SERVICE" -w)" != "$token" ]]; then
      echo "The token checked out but the keychain write did not stick."
      exit 1
    fi
    unset token
    echo "Token works and is stored. Scheduled curation now runs on it. To curate right away: wp curate" ;;
  undo)  # correct the last reaction: wp undo love|interesting|meh  (re-labels it)
    /usr/bin/python3 -I - "${2:-}" <<'EOF'
import sys
sys.path.insert(0, __import__("os").path.expanduser("~/.wallpaper-rotator"))
from events import load, append
last = [e for e in load() if e["type"] == "reaction" and e.get("cmd") in ("love","interesting","meh")][-1]
new = sys.argv[1] or "interesting"
append("correction", ref_ts=last["ts"], field="cmd", value=new)
print(f"corrected: {last['cmd']} -> {new} on {last.get('image')}")
EOF
    ;;
  events)        /usr/bin/python3 -I "$BASE/events.py" tail "${2:-15}" ;;
  status)
    /usr/bin/python3 -I "$BASE/health.py" --status
    echo "pool:    $(ls "$HOME/Pictures/WorldWallpapers"/*.jpg 2>/dev/null | wc -l | tr -d ' ')"
    echo "queue:   $(ls "$BASE/queue" 2>/dev/null | wc -l | tr -d ' ')"
    echo "archive: $(ls "$HOME/Pictures/WorldWallpapers/archive"/*.jpg 2>/dev/null | wc -l | tr -d ' ')"
    echo "next up: $(head -3 "$BASE/playlist.txt" 2>/dev/null | tr '\n' ' ')"
    /usr/bin/python3 -I "$BASE/learn.py" ;;
  *) sed -n '2,13p' "$0"; exit 1 ;;
esac
